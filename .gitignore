packaging/app_icon.icns
packaging/app_icon.iconset/

# OS litter
.DS_Store
Thumbs.db
desktop.ini

# Runtime settings written by the app. config.json holds Cortex credentials,
# which is why it must never be committed again.
config.json
phrases.json
